{
  "manifest_version": 3,
  "name": "PageToPDF — Full Page Screenshot & PDF",
  "short_name": "PageToPDF",
  "version": "1.0.0",
  "description": "Capture an entire web page as a high-resolution PNG or a searchable PDF with smart page breaks, links and optional background removal. Free & open source.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Capture full page",
    "default_popup": "pages/popup.html",
    "default_icon": {
      "16": "icons/toolbar-light-16.png",
      "32": "icons/toolbar-light-32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "pages/options.html",
  "incognito": "split",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "unlimitedStorage",
    "downloads",
    "contextMenus",
    "offscreen",
    "debugger"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "commands": {
    "capture-page": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Capture the full page"
    }
  }
}
